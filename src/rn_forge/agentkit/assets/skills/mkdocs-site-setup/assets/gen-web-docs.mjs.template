#!/usr/bin/env node
/**
 * Generate the __COMPONENT_FRAMEWORK__ component reference into `docs/reference/web/`.
 *
 * TypeDoc handles plain .ts modules (see typedoc.json) but cannot parse
 * .__COMPONENT_EXT__ components. Rather than adding a heavyweight/immature
 * component-doc generator, this extracts docs from a convention the repo
 * enforces: every __COMPONENT_EXT__ source opens with an HTML comment
 * describing its contract (props, callbacks, state, a11y). That guarantee is
 * what makes a small regex-based extractor viable — it can't break on syntax
 * a real parser would need to understand.
 *
 * Only viable if the repo actually enforces the leading-contract-comment
 * convention on every component file. If it doesn't yet, either adopt the
 * convention (lint rule + CI check) or skip this generator and let
 * `docs/reference/web/components.md` stay handwritten.
 *
 * Writes index.md and components.md only; docs/reference/web/ts/ belongs to
 * TypeDoc and is left alone.
 */
import { readdirSync, readFileSync, mkdirSync, writeFileSync, rmSync } from "node:fs";
import { join, relative, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const source = join(root, "__FRONTEND_SRC__");
const out = join(root, "docs/reference/web");
const ext = ".__COMPONENT_EXT__";

function walk(dir, extensions) {
  const found = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) found.push(...walk(full, extensions));
    else if (extensions.some((e) => entry.name.endsWith(e))) found.push(full);
  }
  return found.sort();
}

function componentContract(text) {
  const match = /^\s*<!--([\s\S]*?)-->/.exec(text);
  if (!match) return null;
  return match[1]
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .join("\n");
}

function propsBlock(text) {
  const match = /let\s*\{[\s\S]*?\}\s*:\s*\{([\s\S]*?)\}\s*=\s*\$props\(\)/.exec(text);
  return match ? match[1].trim() : null;
}

function fence(body, language = "") {
  return "```" + language + "\n" + body + "\n```";
}

rmSync(join(out, "components.md"), { force: true });
rmSync(join(out, "index.md"), { force: true });
mkdirSync(out, { recursive: true });

const components = [];
for (const file of walk(source, [ext])) {
  const text = readFileSync(file, "utf8");
  const rel = relative(source, file);
  const contract = componentContract(text);
  const props = propsBlock(text);
  const lines = [`### \`${rel}\``, ""];
  lines.push(
    contract ?? "_No component contract comment — the conventions require one._",
    "",
  );
  if (props) lines.push("**Props**", "", fence(props, "ts"), "");
  components.push(lines.join("\n"));
}

writeFileSync(
  join(out, "index.md"),
  [
    "# Frontend reference",
    "",
    "Generated from the frontend sources. Do not edit by hand — change the source",
    "comment and regenerate with `./scripts/gen-docs.sh`.",
    "",
    `- [Components](components.md) — ${components.length} sources, from their contract comments`,
    "- [TypeScript modules](ts/index.md) — generated by TypeDoc from TSDoc",
    "",
  ].join("\n"),
);
writeFileSync(
  join(out, "components.md"),
  ["# Components", "", `One entry per \`${ext}\` source, from its contract comment.`, "", ...components].join(
    "\n",
  ),
);
console.log(`docs/reference/web: ${components.length} components`);
