  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.rn-forge/agentkit/claude/hooks/post-edit-format.sh",
            "statusMessage": "Formatting edited file"
          }
